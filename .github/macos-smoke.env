# What the macOS smoke test checks. Edit this file and push the branch to run it against a release.
# REPO and TAG name the published release; the two heights are what that release's mainnet
# parameters must report (dslstatus). Leave a height empty to print it without checking it.
REPO=defcon-project/defcon
TAG=v23.0.0
EXPECT_DSL_ACTIVATION=145464
EXPECT_DSL_ENFORCEMENT=2147483647
